# ==============================================================================
# Образец конфигурации: tg-bot-agent (.env-template)
# Скопируйте этот файл в .env:
#   cp .env-template .env
# и заполните обязательные параметры TELEGRAM_BOT_TOKEN и TELEGRAM_ADMIN_ID
# ==============================================================================

# [ОБЯЗАТЕЛЬНО] Токен вашего Telegram-бота, полученный от @BotFather
# Пример: 1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# [ОБЯЗАТЕЛЬНО] Числовой ID администратора в Telegram.
# Бот отвечает ТОЛЬКО пользователю с этим ID (все остальные запросы игнорируются).
# Узнать свой ID можно у бота @userinfobot
TELEGRAM_ADMIN_ID=123456789

# [ОПЦИОНАЛЬНО] Корневой каталог для хранения репозиториев проектов
# Значение по умолчанию: /home/deploy/projects
PROJECTS_ROOT=/home/deploy/projects

# [ОПЦИОНАЛЬНО] Проект по умолчанию, выбираемый при старте бота (каталог внутри PROJECTS_ROOT)
# Значение по умолчанию: tg-bot-agent
DEFAULT_PROJECT=tg-bot-agent

# [ОПЦИОНАЛЬНО] Модель Antigravity CLI (agy) по умолчанию для выполнения задач
# Значение по умолчанию: gemini-3.1-pro-high
# Доступные алиасы: default, flash, flash-high, flash-low, pro, pro-low, sonnet, opus, oss
DEFAULT_MODEL=gemini-3.1-pro-high

# [ОПЦИОНАЛЬНО] Таймаут ожидания ответа пользователя на вопрос агента (ask_question)
# При отсутствии ответа задача автоматически переводится в статус паузы (paused)
# Форматы: 15m, 10m, 300s или число секунд
# Значение по умолчанию: 15m
QUESTION_TIMEOUT=15m

# [ОПЦИОНАЛЬНО] Путь к директории бота для выполнения команды /rebuild и сохранения маркеров перезапуска
# Значение по умолчанию: автоопределение или /home/deploy/tg-agent-bot
BOT_DIR=/home/deploy/tg-agent-bot

# [ОПЦИОНАЛЬНО] Имя systemd службы бота для перезапуска через /restart и /rebuild
# Значение по умолчанию: tg-bot.service
BOT_SERVICE_NAME=tg-bot.service
