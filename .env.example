# ==============================================================================
# Конфигурация bro-bot (Telegram Agent Bridge Bot)
# ==============================================================================

# [ОПЦИОНАЛЬНО] Мессенджер, через который работает бот. Пока поддерживается только
# telegram — значение по умолчанию, менять не нужно. Существует как точка расширения:
# новый мессенджер подключается одним адаптером в internal/adapters/, без изменений
# в остальном коде бота (см. internal/ports.Transport).
MESSENGER=telegram

# [ОБЯЗАТЕЛЬНО] Токен вашего Telegram-бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# [ОБЯЗАТЕЛЬНО] Числовой Telegram ID администратора (бот обрабатывает запросы только от него).
# Узнать свой ID можно через бота @userinfobot
TELEGRAM_ADMIN_ID=123456789

# [ОБЯЗАТЕЛЬНО] Корневой каталог для проектов репозиториев
PROJECTS_ROOT=/home/deploy/projects

# [ОПЦИОНАЛЬНО] Имя проекта по умолчанию при запуске бота (папка внутри PROJECTS_ROOT)
# Если не задано, бот будет использовать первую найденную папку.
DEFAULT_PROJECT=bro-bot

# [ОБЯЗАТЕЛЬНО] Модель по умолчанию для Antigravity CLI (agy)
# Доступные алиасы: default, flash, flash-high, flash-low, pro, pro-low, sonnet, opus, oss
DEFAULT_MODEL=gemini-3.1-pro-high

# [ОБЯЗАТЕЛЬНО] Таймаут ожидания ответа на интерактивный вопрос агента (ask_question)
# При превышении задача автоматически ставится на паузу
# Поддерживаются форматы 15m, 10m, 300s или число секунд
QUESTION_TIMEOUT=15m

# [ОПЦИОНАЛЬНО] Таймаут одного ответа в разговорном режиме (/chat)
# По умолчанию: 5m. Поддерживаются форматы 5m, 300s или число секунд.
CHAT_TIMEOUT=5m

# [ОПЦИОНАЛЬНО] Таймаут выполнения одного шага агента agy (print-timeout)
# По умолчанию: 30m. Поддерживаются форматы 30m, 1h, 1800s или число секунд.
# При превышении задача ставится на паузу с сохранением сессии agy для продолжения.
STEP_TIMEOUT=30m

# [ОПЦИОНАЛЬНО] Сколько раз подряд автоматически продолжать шаг, если агент завершил ход,
# не дождавшись своих фоновых команд (agy пишет «terminating N background task(s) on exit»).
# Продолжение идёт в той же сессии агента. Когда лимит исчерпан, задача ставится на паузу
# с кнопкой «Продолжить», а не объявляется завершённой.
# По умолчанию: 2. Значение 0 отключает автопродолжение.
AUTO_CONTINUE_MAX=2

# [ОПЦИОНАЛЬНО] Каталог исходного кода бота для выполнения команд /rebuild и сохранения маркеров перезапуска
# По умолчанию: каталог исполняемого файла, если рядом с ним лежит go.mod.
# Если определить не удалось, бот не стартует и скажет об этом.
BOT_DIR=/home/deploy/bro-bot

# [ОБЯЗАТЕЛЬНО] Имя systemd службы для перезапуска бота через /restart и /rebuild
BOT_SERVICE_NAME=bro-bot.service

# [ОПЦИОНАЛЬНО] Путь к файлу базы данных SQLite для персистентности задач, планов и настроек
# По умолчанию: data/bot.db внутри каталога BOT_DIR
SQLITE_DB_PATH=data/bot.db

# [ОПЦИОНАЛЬНО] Каталог с пользовательскими скриптами для команды /script
# По умолчанию: scripts внутри каталога BOT_DIR
SCRIPTS_DIR=/home/deploy/bro-bot/scripts

# ------------------------------------------------------------------------------
# Ключи агентов для режима api (/mode api). В режимах mcp и cli они не нужны.
# В режиме api агентам доступны инструменты работы с файлами рабочей директории
# (чтение и изменение файлов при задачах, безопасное чтение в диалоге).
# Ключи читаются при каждом обращении к API: дописав ключ в .env, перезапускать
# бота не нужно.
# ------------------------------------------------------------------------------

# [ОПЦИОНАЛЬНО] Ключ Google AI Studio для агента agy в режиме api.
# Без него режим api у agy недоступен.
GEMINI_API_KEY=

# [ОПЦИОНАЛЬНО] Явное имя модели Gemini API для режима api (например, gemini-2.5-flash).
# Если не задано, модель выбирается из тех, что реально отдаёт API.
GEMINI_API_MODEL=

# [ОПЦИОНАЛЬНО] Ключ Anthropic для агента claude в режиме api.
# Без него (и без CLAUDE_API_KEY) режим api у claude недоступен.
ANTHROPIC_API_KEY=

# [ОПЦИОНАЛЬНО] Устаревшее имя той же переменной: используется, если ANTHROPIC_API_KEY не задан.
CLAUDE_API_KEY=

# [ОПЦИОНАЛЬНО] Явное имя модели Claude API для режима api (например, claude-sonnet-5).
# Если не задано, модель выбирается из списка /v1/models.
CLAUDE_API_MODEL=

# ------------------------------------------------------------------------------
# Распознавание голосовых сообщений (Whisper Server / Speech-to-Text)
# ------------------------------------------------------------------------------

# [ОПЦИОНАЛЬНО] URL HTTP-сервера Whisper (whisper.cpp server, faster-whisper, OpenAI API и др.)
# Поддерживает как эндпоинт whisper.cpp /inference, так и OpenAI-совместимый /v1/audio/transcriptions (с авто-fallback).
# По умолчанию для локального whisper-server (make install-whisper): http://127.0.0.1:8080/inference
# Оставьте пустым, если распознавание голосовых не требуется.
WHISPER_SERVER_URL=http://127.0.0.1:8080/inference

# [ОПЦИОНАЛЬНО] Токен авторизации (Bearer token), если whisper-server защищён авторизацией
WHISPER_API_KEY=

# [ОПЦИОНАЛЬНО] Модель Whisper (по умолчанию: base-q5_1)
WHISPER_MODEL=base-q5_1

# [ОПЦИОНАЛЬНО] Язык распознавания речи (ru, en, auto и др.).
# По умолчанию: en. Для переключения языка, например на русский, установите: WHISPER_LANGUAGE=ru
WHISPER_LANGUAGE=en

# [ОПЦИОНАЛЬНО] Таймаут запроса на распознавание речи
# По умолчанию: 60s. Поддерживаются форматы 60s, 2m или число секунд.
WHISPER_TIMEOUT=60s

# [ОПЦИОНАЛЬНО] Контекстная подсказка и доменный словарь для Whisper (prompt / initial_prompt).
# Задаёт словарь технических терминов и сленга для предотвращения фонетических искажений
# (например, «дебаг режим» вместо «покрыши» или «pull request» вместо созвучных слов).
# В коде словарь по умолчанию не зашит — управление осуществляется через эту переменную.
# При копировании .env.example в .env здесь сразу предзаполнен словарь терминов:
WHISPER_PROMPT="дебаг, дебаг режим, debug, git, checkout, gitlab, github, docker ps, docker compose, gRPC, парсить, шёпот, распознавание, коммит, пулл реквест, PR, мердж, деплой, билд, прод, логи, статус, таски, фикс, VAD, STT"
# Для распознавания на английском языке можно использовать:
# WHISPER_PROMPT="debug mode, code, commit, pull request, git, bot, deploy, status, tasks, logs, review, build, release, terminal"
# Чтобы полностью отключить подсказку, оставьте значение пустым или установите: WHISPER_PROMPT=none

# [ОПЦИОНАЛЬНО] Температура сэмплинга Whisper (от 0.0 до 1.0).
# При значении 0.0 используется строгий жадный выбор наиболее вероятных токенов (без галлюцинаций).
# По умолчанию: 0.0
WHISPER_TEMPERATURE=0.0

# [ОПЦИОНАЛЬНО] Нормализация громкости звука через ffmpeg (фильтр loudnorm EBU R128).
# Улучшает разборчивость тихой речи, шёпота и записей с низким уровнем микрофона.
# По умолчанию: true. Чтобы отключить: WHISPER_LOUDNORM=false
WHISPER_LOUDNORM=true

# [ОПЦИОНАЛЬНО] Режим отладки (debug mode).
# Если включён (true, 1), в чат Telegram выводится расширенная техническая информация
# (например, замер времени STT, длительность аудио и RTF при распознавании голосовых сообщений).
# По умолчанию: false (пустое значение).
DEBUG=

