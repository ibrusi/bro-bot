# ==============================================================================
# Конфигурация tg-bot-agent (Telegram Agent Bridge Bot)
# ==============================================================================

# [ОБЯЗАТЕЛЬНО] Токен вашего Telegram-бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# [ОБЯЗАТЕЛЬНО] Числовой Telegram ID администратора (бот обрабатывает запросы только от него).
# Узнать свой ID можно через бота @userinfobot
TELEGRAM_ADMIN_ID=123456789

# [ОБЯЗАТЕЛЬНО] Корневой каталог для проектов репозиториев
PROJECTS_ROOT=/home/deploy/projects

# [ОПЦИОНАЛЬНО] Имя проекта по умолчанию при запуске бота (папка внутри PROJECTS_ROOT)
# Если не задано, бот будет использовать первую найденную папку.
DEFAULT_PROJECT=tg-bot-agent

# [ОБЯЗАТЕЛЬНО] Модель по умолчанию для Antigravity CLI (agy)
# Доступные алиасы: default, flash, flash-high, flash-low, pro, pro-low, sonnet, opus, oss
DEFAULT_MODEL=gemini-3.1-pro-high

# [ОБЯЗАТЕЛЬНО] Таймаут ожидания ответа на интерактивный вопрос агента (ask_question)
# При превышении задача автоматически ставится на паузу
# Поддерживаются форматы 15m, 10m, 300s или число секунд
QUESTION_TIMEOUT=15m

# [ОПЦИОНАЛЬНО] Каталог исходного кода бота для выполнения команд /rebuild и сохранения маркеров перезапуска
# По умолчанию: автоопределение пути исполняемого файла
BOT_DIR=/home/deploy/tg-agent-bot

# [ОБЯЗАТЕЛЬНО] Имя systemd службы для перезапуска бота через /restart и /rebuild
BOT_SERVICE_NAME=tg-bot.service
